{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-malicious-commands.sh",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}